classDiagram
    class Task {
        +str description
        +str time
        +date due_date
        +str frequency
        +bool completed
        +mark_complete() None
    }
    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task) None
    }
    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet) None
        +get_all_tasks() list~Task~
    }
    class Scheduler {
        +Owner owner
        +sort_by_time() list~Task~
    }
    Owner "1" *-- "0..*" Pet : cares for
    Pet "1" *-- "0..*" Task : has
    Scheduler --> Owner : retrieves all tasks
